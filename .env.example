# Copy to .env for local dev (NEVER commit .env). On Render, set these in
# the dashboard under Environment instead.

# Provider preference. One of: auto | gemini | groq | openrouter | cerebras | heuristic
# auto = try configured providers in LLM_FALLBACK_PROVIDERS order.
LLM_PROVIDER=auto
# Deterministic fallback order used when LLM_PROVIDER=auto. Providers
# without an API key are skipped automatically.
LLM_FALLBACK_PROVIDERS=gemini,groq,openrouter,cerebras
# Offline heuristic may only run automatically when this is true AND it is
# the final entry in the chain (or the user explicitly requests it).
LLM_ALLOW_HEURISTIC_FALLBACK=false

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=25

# Groq (OpenAI-compatible chat completions)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter (OpenAI-compatible chat completions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Cerebras (OpenAI-compatible chat completions)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

SESSION_SECRET=change-me-to-32-plus-random-chars
APP_BASE_URL=http://127.0.0.1:8765
APP_USERNAME=
APP_PASSWORD_HASH=
DATA_DIR=data
PORT=8765
FLASK_ENV=development
