# Copy to .env for local dev (NEVER commit .env). On Render, set these in
# the dashboard under Environment instead.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=25
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
SESSION_SECRET=change-me-to-32-plus-random-chars
APP_BASE_URL=http://127.0.0.1:8765
APP_USERNAME=
APP_PASSWORD_HASH=
DATA_DIR=data
PORT=8765
FLASK_ENV=development
